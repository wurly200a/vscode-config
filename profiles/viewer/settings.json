// viewer: Markdown 閲覧用（Mermaid・数式・画像込み）
// 方針: 頼んでいないものは出さない。更新は自分のタイミングで。
{
  // ---- 更新・通知 ----
  "update.mode": "manual",              // 本体の自動更新をしない（apt / winget で更新）
  "update.showReleaseNotes": false,     // 更新後のリリースノートを開かない
  "extensions.autoCheckUpdates": false, // 拡張の更新確認をしない
  "extensions.autoUpdate": false,       // 拡張を勝手に更新しない
  "workbench.tips.enabled": false,      // Tips を出さない
  "workbench.startupEditor": "none",    // Welcome ページを出さない
  "window.restoreWindows": "none",      // 前回のウィンドウを復元しない（開いたファイルだけ表示）

  // ---- 画面の飾りを消す ----
  "workbench.activityBar.location": "hidden",
  "workbench.statusBar.visible": false,
  "workbench.layoutControl.enabled": false,
  "window.commandCenter": false,
  "editor.minimap.enabled": false,
  "breadcrumbs.enabled": false,
  "window.menuBarVisibility": "toggle", // メニューバーは Alt で出す

  // ---- 制限モード（Restricted Mode）----
  // 信頼していないフォルダでは制限モードのまま使う（AI 出力を開く用途なので保護は残す）。
  // 上部の案内バナーだけ出さない。
  "security.workspace.trust.banner": "never",

  // ---- 日本語文書で出る Unicode ハイライトを止める ----
  // 「non-basic ASCII unicode characters」の警告バーと、全角記号の枠表示を出さない
  "editor.unicodeHighlight.nonBasicASCII": false,
  "editor.unicodeHighlight.ambiguousCharacters": false,

  // ---- AI 系 UI（Copilot Chat など）を消す ----
  "chat.disableAIFeatures": true,

  // ---- Markdown ----
  "markdown-preview-enhanced.previewTheme": "github-light.css",
  // .md を開いたら Markdown Preview Enhanced のプレビューを横に自動で開く
  "markdown-preview-enhanced.automaticallyShowPreviewOfMarkdownBeingEdited": true
}
